# Copy to .env and fill in. Used by docker-compose.yml. NEVER commit the real .env.

# --- Database (choose strong random passwords) ---
DB_PASSWORD=change-me-strong
DB_ROOT_PASSWORD=change-me-strong-too

# --- Domain ---
# The single domain that serves the whole app (API + PWA). Point its A record at your VPS IP; Caddy gets
# HTTPS for it automatically. Email links + CORS are derived from it.
APP_DOMAIN=homeos.yourdomain.com

# --- Email (optional; leave blank to disable outgoing mail) ---
SMTP_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SSL=false

# --- Demo data (optional) ---
# Set DEMO_ENABLED=true to seed a "Demo Home" household with sample data + a demo login (demo@imel.ba).
# Change DEMO_PASSWORD from the default on a public server. Leave DEMO_ENABLED=false for a clean instance.
DEMO_ENABLED=false
DEMO_PASSWORD=

# --- AI assistant (optional; free options: Groq or Google Gemini) ---
# Groq (free):   PROVIDER=openai  BASE_URL=https://api.groq.com/openai/v1        MODEL=llama-3.3-70b-versatile
# Gemini (free): PROVIDER=openai  BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  MODEL=gemini-2.0-flash
# Anthropic:     PROVIDER=anthropic (BASE_URL unused)                            MODEL=claude-sonnet-5
ASSISTANT_PROVIDER=openai
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://api.groq.com/openai/v1
ASSISTANT_MODEL=llama-3.3-70b-versatile
