{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-backend",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build",
        "${workspaceFolder}/backend/HomeOs.sln",
        "/property:GenerateFullPaths=true",
        "/consoleloggerparameters:NoSummary",
        "-v",
        "quiet"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "web-dev",
      "type": "shell",
      "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vite",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*(VITE|vite).*",
          "endsPattern": ".*(Local:|localhost:5173).*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "run" }
    },
    {
      "label": "run-api",
      "type": "process",
      "command": "dotnet",
      "args": ["run"],
      "options": { "cwd": "${workspaceFolder}/backend/src/HomeOs.Api" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "dotnet",
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Building.*",
          "endsPattern": ".*(Now listening on|Application started).*"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated", "group": "run" }
    }
  ]
}
