{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API (.NET)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/backend/src/HomeOs.Api/bin/Debug/net8.0/HomeOs.Api.dll",
      "cwd": "${workspaceFolder}/backend/src/HomeOs.Api",
      "launchSettingsProfile": "http",
      "env": { "ASPNETCORE_ENVIRONMENT": "Development" },
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Web (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "web-dev",
      "sourceMaps": true
    },
    {
      "name": "Web (Edge)",
      "type": "msedge",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend",
      "preLaunchTask": "web-dev",
      "sourceMaps": true
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (API + Web)",
      "configurations": ["API (.NET)", "Web (Chrome)"],
      "stopAll": true
    }
  ]
}
