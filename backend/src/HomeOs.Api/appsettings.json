{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Database": {
    "AutoMigrate": true,
    "Seed": true
  },
  "Frontend": {
    "//": "Base URL used to build invite links. In a same-origin deploy this is the app's own URL.",
    "BaseUrl": "http://localhost:5173"
  },
  "Email": {
    "//": "Leave Smtp.Host empty to log emails to the console (dev). Set real values via user-secrets or env vars.",
    "From": "Home OS <no-reply@homeos.local>",
    "Smtp": {
      "Host": "",
      "Port": "587",
      "User": "",
      "Password": "",
      "UseSsl": "true"
    }
  },
  "AllowedHosts": "*"
}
